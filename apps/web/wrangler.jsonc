{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "todo-web",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-db",
      "database_id": "replace-with-production-database-id",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "todo-files",
    },
  ],
  "queues": {
    // Mails to send (for example "a task was shared with you"). The reminder worker sends them.
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "todo-notifications",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION",
        "class_name": "CollaborationRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollaborationRoom"],
    },
  ],
}
