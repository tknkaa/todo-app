{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kanban-web",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanban-db",
      "database_id": "5f20a0e8-27aa-46dd-9b4a-aee7ae1a5e9c",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kanban-files",
    },
  ],
  "queues": {
    // Mails to send (for example "a task was shared with you"). The reminder worker sends them.
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "kanban-notifications",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION",
        "class_name": "CollaborationRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollaborationRoom"],
    },
  ],

  // Preview deployments (a branch or a pull request) run as their own Worker with their own
  // database, bucket and queue, so trying a change never touches production data. Bindings are
  // not inherited by an environment, so each one is written out again. See docs/deploy.md.
  "env": {
    "preview": {
      "name": "kanban-web-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kanban-db-preview",
          "database_id": "3e03d55d-c10d-46fc-8014-9adcec53b7b2",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "kanban-files-preview",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_QUEUE",
            "queue": "kanban-notifications-preview",
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "COLLABORATION",
            "class_name": "CollaborationRoom",
          },
        ],
      },
    },
  },
}
