{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kanban-web",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // The address of the deployed app. Login only accepts requests from this origin, so it has to
    // match the real address. A local `pnpm dev` takes its own value from apps/web/.dev.vars.
    "BETTER_AUTH_URL": "https://kanban-web.ut-code.workers.dev",
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanban-db",
      "database_id": "5f20a0e8-27aa-46dd-9b4a-aee7ae1a5e9c",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kanban-files",
    },
  ],
  "queues": {
    // Mails to send (for example "a task was shared with you"). The reminder worker sends them.
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "kanban-notifications",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION",
        "class_name": "CollaborationRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollaborationRoom"],
    },
  ],

  // Worker Previews: every branch other than main gets its own Preview of this Worker, at
  // `<branch>-kanban-web.ut-code.workers.dev`. Durable Objects are separate per Preview on their
  // own. D1, R2 and queues would be shared with production unless they are named here, so they
  // point at the preview resources (shared by all Previews). BETTER_AUTH_URL differs per Preview
  // and is passed by scripts/deploy-preview.sh. See docs/deploy.md.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "kanban-db-preview",
        "database_id": "3e03d55d-c10d-46fc-8014-9adcec53b7b2",
        "migrations_dir": "../../packages/db/migrations",
      },
    ],
    "r2_buckets": [
      {
        "binding": "FILES",
        "bucket_name": "kanban-files-preview",
      },
    ],
    "queues": {
      "producers": [
        {
          "binding": "NOTIFICATION_QUEUE",
          "queue": "kanban-notifications-preview",
        },
      ],
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "COLLABORATION",
          "class_name": "CollaborationRoom",
        },
      ],
    },
  },
}
