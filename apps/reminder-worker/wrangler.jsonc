{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "todo-reminder-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "vars": {
    // Where the links in mails point to, and who they come from. Set RESEND_API_KEY as a secret.
    "APP_URL": "http://localhost:8787",
    "REMINDER_FROM": "onboarding@resend.dev",
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-db",
      "database_id": "replace-with-production-database-id",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "REMINDER_QUEUE",
        "queue": "todo-reminders",
      },
    ],
    "consumers": [
      {
        "queue": "todo-reminders",
        "max_batch_size": 10,
        "max_retries": 3,
        // A mail that still fails after its retries is kept here instead of being dropped.
        "dead_letter_queue": "todo-mail-dead-letter",
      },
      {
        "queue": "todo-notifications",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "todo-mail-dead-letter",
      },
    ],
  },
}
